rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 실시간 채팅 메시지 (읽기, 작성, 삭제 허용)
    match /chat_messages/{id} {
      allow read, create, delete: if true;
    }
    
    // 시·군 참여 댓글 및 공감(좋아요)
    match /city_comments/{id} {
      allow read, create, update, delete: if true;
    }
  }
}
